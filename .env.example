# Copy this file to .env for local development. Every variable the app reads is listed here.
# Never commit real values.

# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/penguin_training_portal"

# Public base URL of the app, no trailing slash. Used to build invite and sign-in links.
# Session cookies are marked Secure when this starts with https://.
APP_URL="http://localhost:3000"

# Long random string used to hash session, invite, and sign-in link tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Comma-separated emails of the first Penguin Strategies super-admins (PENGUIN_ADMIN).
# The seed creates (or promotes) a PENGUIN_ADMIN account for each one on every start.
ADMIN_EMAILS=""

# One-time bootstrap password (10 characters or more) for admin accounts that have no password yet.
# The seed never overwrites an existing password unless ADMIN_PASSWORD_RESET is true.
ADMIN_INITIAL_PASSWORD=""

# Set to "true" for one deploy to force ADMIN_INITIAL_PASSWORD onto every ADMIN_EMAILS account.
ADMIN_PASSWORD_RESET=""

# Optional. Resend API key for invite, password-reset, and sign-in link email.
RESEND_API_KEY=""

# Optional. From address for outgoing email. The domain must be verified in Resend.
EMAIL_FROM="Penguin Training Portal <training@example.com>"

# Optional. Session lifetime in days, sliding. Defaults to 30.
SESSION_TTL_DAYS="30"

# Optional. How long access events, training attempts, and audits are kept, in days. Defaults to 730.
LOG_RETENTION_DAYS="730"

# Optional: Google OAuth 2.0 sign-in (invite-only). Callback: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Microsoft Entra ID (Azure AD) OAuth 2.0 sign-in (invite-only).
# Callback: <APP_URL>/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
